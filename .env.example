# ==========================================
# KirayLink — Environment Variables Template
# ==========================================

# Secret key used to sign and verify session tokens with jose (HMAC-SHA256).
# Must be at least 32 characters long.
# Generate in production using: openssl rand -base64 32
AUTH_SECRET=your-secure-32-character-auth-secret-here

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
